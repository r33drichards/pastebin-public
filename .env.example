# Optional WordPress plugin environment. Configure database/WordPress credentials
# through the site's existing secure hosting configuration, not this repository.
#
# Rate limits per client/route (production defaults: 2 and 5 requests/second).
# PBIN_RATE_LIMIT=2
# PBIN_COMPLETION_RATE_LIMIT=5
#
# Optional AI completion. Leave unset for deterministic, offline-capable tests.
HF_TOKEN=
# COMPLETION_MODEL=Qwen/Qwen2.5-Coder-0.5B:featherless-ai
# COMPLETION_FALLBACK_URL=
# COMPLETION_FALLBACK_TOKEN=
# COMPLETION_FALLBACK_MODEL=Qwen/Qwen2.5-Coder-0.5B
# Optional title generation:
OPENAPIKEY=
#
# Routing and preview settings are constants in wp-config.php, documented in
# wordpress/README.md. PBIN_TABLE_NAME, PBIN_URL, DB_PATH and PORT were legacy
# Go-server settings and are not used by the supported WordPress backend.
