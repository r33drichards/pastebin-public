# OpenAI API Key (optional, for title generation)
OPENAPIKEY=sk-...

# AI tab completion (optional): Hugging Face token with the
# "Make calls to Inference Providers" permission. Enables ghost-text
# code completion in the editor via Qwen2.5-Coder-0.5B.
HF_TOKEN=
# Override the routed model/provider (default: Qwen/Qwen2.5-Coder-0.5B:featherless-ai)
#COMPLETION_MODEL=
# Fallback OpenAI-compatible completion server, tried when Hugging Face
# fails — e.g. vLLM on Modal (see examples/modal_fim_server.py).
#COMPLETION_FALLBACK_URL=
#COMPLETION_FALLBACK_TOKEN=
#COMPLETION_FALLBACK_MODEL=Qwen/Qwen2.5-Coder-0.5B

# DynamoDB Table Name (optional, for paste storage)
PBIN_TABLE_NAME=

# Public URL of your deployment
PBIN_URL=http://localhost:8000

# Server Port (default: 8000)
PORT=8000
